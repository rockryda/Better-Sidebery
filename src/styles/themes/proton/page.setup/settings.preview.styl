// Live preview of the sidebar (settings page, right side)

.SettingsPreview
  position: relative
  width: calc(100% - 32px)
  max-width: 640px
  margin: 12px auto 0
  padding: 12px
  border: 1px solid rgba(128, 128, 128, .35)
  border-radius: 12px
  background-color: var(--frame-bg)
  color: var(--toolbar-fg)
  z-index: 30

.SettingsPreview .sp-head
  margin-bottom: 8px

.SettingsPreview .sp-title
  font-size: rem(16)
  font-weight: 700

.SettingsPreview .sp-note
  margin-top: 2px
  font-size: rem(12)
  opacity: .7
  line-height: 1.4

.SettingsPreview .sp-note.-small
  margin-top: 8px

.SettingsPreview .sp-screen
  position: relative
  display: flex
  height: var(--sp-h, 440px)
  border-radius: 8px
  overflow: hidden
  background-color: #2a3440

.SettingsPreview .sp-screen[data-scheme="light"]
  background-color: #e9eef3

.SettingsPreview .page-body
  flex: 1
  min-width: 0
  display: grid
  gap: 8px
  align-content: start
  padding: 14px 12px

.SettingsPreview .page-body i
  display: block
  height: 9px
  border-radius: 4px
  background-color: rgba(128, 128, 128, .3)

.SettingsPreview .page-body i:first-child
  height: 14px

.SettingsPreview .sp-modes
  display: inline-flex
  margin-top: 10px
  border: 1px solid rgba(128, 128, 128, .4)
  border-radius: 8px
  overflow: hidden

.SettingsPreview .sp-modes button
  padding: 4px 12px
  font-size: rem(12)
  border: 0
  border-left: 1px solid rgba(128, 128, 128, .4)
  background-color: transparent
  color: inherit
  cursor: pointer

.SettingsPreview .sp-modes button:first-child
  border-left: 0

.SettingsPreview .sp-modes button[data-active="true"]
  background-color: var(--toolbar-fg)
  color: var(--frame-bg)
  font-weight: 600

// -- Real sidebar in a read-only frame

.SettingsPreview .frame
  position: relative
  z-index: 2
  flex: none
  height: 100%
  overflow: hidden
  background-color: #1c1b22

.SettingsPreview .sp-screen[data-scheme="light"] .frame
  background-color: #f6f8fa

.SettingsPreview .frame[data-anim="true"]
  transition: width .22s, box-shadow .22s

.SettingsPreview .frame[data-mode="full"]
  width: 250px

.SettingsPreview .frame[data-mode="collapsed"]
.SettingsPreview .frame[data-mode="auto"]
  width: 50px

// Auto: opens over the page while hovered, like the real hover rail
.SettingsPreview .frame[data-mode="auto"]:hover
  width: 250px
  margin-right: -200px
  box-shadow: 6px 0 22px rgba(0, 0, 0, .35)

.SettingsPreview .frame[data-editing="true"] iframe
  pointer-events: auto

.SettingsPreview .frame iframe
  display: block
  width: 100%
  height: 100%
  border: 0
  // Locked by default: clicks never reach the sidebar inside
  pointer-events: none

// Wide windows: dock the preview on the right and leave room for it
@media (min-width: 1120px)
  .Settings
    box-sizing: border-box
    padding-right: calc(var(--sp-w, 300px) + 32px)

  .SettingsPreview
    position: fixed
    top: 16px
    right: 16px
    width: var(--sp-w, 300px)
    max-height: calc(100vh - 32px)
    margin: 0
    overflow: auto

@media (prefers-reduced-motion: reduce)
  .SettingsPreview .sb
    transition: none

// Status line and the save bar
.SettingsPreview .sp-state
  display: inline-block
  margin-top: 10px
  margin-right: 10px
  padding: 2px 10px
  border: 1px solid rgba(128, 128, 128, .45)
  border-radius: 999px
  font-size: rem(12)
  opacity: .85

.SettingsPreview .sp-state[data-editing="true"]
  border-color: #d9a21b
  color: #d9a21b
  opacity: 1

.SettingsSaveBar
  position: sticky
  bottom: 14px
  z-index: 40
  display: flex
  gap: 10px
  align-items: center
  width: fit-content
  max-width: calc(100% - 32px)
  margin: 16px auto 0
  padding: 8px 10px 8px 16px
  border: 1px solid rgba(128, 128, 128, .45)
  border-radius: 12px
  background-color: var(--frame-bg)
  box-shadow: 0 6px 24px rgba(0, 0, 0, .35)
  color: var(--toolbar-fg)

.SettingsSaveBar .msg
  font-size: rem(14)

.SettingsSaveBar .btn.-primary
  font-weight: 700

// Resize grips: left edge (width, wide windows only) and the strip under the screen (height)
.SettingsPreview .sp-grip
  position: absolute
  z-index: 5
  background-color: transparent
  touch-action: none

.SettingsPreview .sp-grip:hover
  background-color: rgba(120, 160, 255, .45)

.SettingsPreview .sp-grip.-x
  top: 8px
  bottom: 8px
  left: -4px
  width: 8px
  border-radius: 4px
  cursor: ew-resize
  display: none

.SettingsPreview .sp-grip.-y
  position: relative
  height: 8px
  margin-top: 4px
  border-radius: 4px
  cursor: ns-resize

@media (min-width: 1120px)
  .SettingsPreview .sp-grip.-x
    display: block
